@@ -0,0 +1,146 @@
+package safeerrorprojection
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+const validEnvelope = `{"error":{"type":"rate_limit_error","code":"upstream_rate_limit","message":"Oracle capacity is temporarily unavailable; retry shortly.","details":{"projection":"vm2api.safe_error.v1","message_unavailable":false,"provider_request_id":"req_fixture","adapter_status":429,"kernel_http_status":200,"status_source":"sse_error_type"},"request_id":"req_nested"},"request_id":"req_top"}`
+
+func TestMatchTrustedOracle429ScopeAndSelector(t *testing.T) {
+	tests := []struct {
+		name      string
+		groupID   int64
+		accountID int64
+		trusted   bool
+		status    int
+		body      string
+		want      bool
+	}{
+		{"correct match", 18, 1146, true, 429, validEnvelope, true},
+		{"wrong group", 1, 1146, true, 429, validEnvelope, false},
+		{"wrong account", 18, 1147, true, 429, validEnvelope, false},
+		{"missing group context", 0, 1146, true, 429, validEnvelope, false},
+		{"missing account context", 18, 0, true, 429, validEnvelope, false},
+		{"untrusted source", 18, 1146, false, 429, validEnvelope, false},
+		{"wrong status", 18, 1146, true, 503, validEnvelope, false},
+		{"marker forged outside selector", 18, 1146, true, 429, `{"error":{"type":"rate_limit_error","code":"upstream_rate_limit","message":"vm2api.safe_error.v1","details":{"message_unavailable":false}},"projection":"vm2api.safe_error.v1"}`, false},
+		{"wrong error type", 18, 1146, true, 429, strings.Replace(validEnvelope, `"rate_limit_error"`, `"upstream_error"`, 1), false},
+		{"wrong error code", 18, 1146, true, 429, strings.Replace(validEnvelope, `"upstream_rate_limit"`, `"other"`, 1), false},
+		{"missing unavailable flag", 18, 1146, true, 429, strings.Replace(validEnvelope, `,"message_unavailable":false`, ``, 1), false},
+		{"malformed json", 18, 1146, true, 429, `{"error":`, false},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			got, ok := MatchTrustedOracle429(tc.groupID, tc.accountID, tc.trusted, tc.status, []byte(tc.body))
+			if ok != tc.want {
+				t.Fatalf("matched=%v, want %v; result=%+v", ok, tc.want, got)
+			}
+			if ok && got.Message != "Oracle capacity is temporarily unavailable; retry shortly." {
+				t.Fatalf("unexpected projected message %q", got.Message)
+			}
+		})
+	}
+}
+
+func TestTrustedSourceRequiresExactServerSideEndpoint(t *testing.T) {
+	tests := []struct {
+		name      string
+		accountID int64
+		platform  string
+		baseURL   string
+		want      bool
+	}{
+		{"exact", 1146, "anthropic", "http://oracle-vm2api-verify:18080", true},
+		{"wrong account", 1147, "anthropic", "http://oracle-vm2api-verify:18080", false},
+		{"wrong platform", 1146, "openai", "http://oracle-vm2api-verify:18080", false},
+		{"wrong host", 1146, "anthropic", "http://oracle-vm2api-other:18080", false},
+		{"trailing slash not exact", 1146, "anthropic", "http://oracle-vm2api-verify:18080/", false},
+		{"missing endpoint", 1146, "anthropic", "", false},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := IsTrustedSource(tc.accountID, tc.platform, tc.baseURL); got != tc.want {
+				t.Fatalf("trusted=%v, want %v", got, tc.want)
+			}
+		})
+	}
+}
+
+func TestMatchTrustedOracle429RejectsUnsafeOrUnavailableMessages(t *testing.T) {
+	tests := []struct {
+		name    string
+		message string
+	}{
+		{"over 400 utf8 bytes", strings.Repeat("界", 134)},
+		{"control", "retry soon\nAuthorization: hidden"},
+		{"leading control", "\nretry soon"},
+		{"api secret", "api_key=sk-sensitive-value"},
+		{"password assignment", "password=hunter2"},
+		{"secret json assignment", `secret":"must-not-leak`},
+		{"jwt short segments", "token abcdefgh.ijklmnop.qrstuvwx"},
+		{"https url query", "retry via https://example.invalid/path?token=hidden"},
+		{"unix path", "adapter failed at /home/service/.env"},
+		{"windows path", `adapter failed at C:\\service\\secret.txt`},
+		{"windows slash path", "adapter failed at C:/service/secret.txt"},
+		{"prompt stack", "system prompt stack trace unavailable"},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			body := envelopeWithMessage(t, tc.message, false)
+			if got, ok := MatchTrustedOracle429(18, 1146, true, 429, body); ok {
+				t.Fatalf("unsafe message matched: %+v", got)
+			}
+		})
+	}
+
+	unavailable := envelopeWithMessage(t, "must not be exposed", true)
+	got, ok := MatchTrustedOracle429(18, 1146, true, 429, unavailable)
+	if !ok || !got.MessageUnavailable || got.Message != "Upstream error details unavailable" {
+		t.Fatalf("message_unavailable result=%+v matched=%v", got, ok)
+	}
+}
+
+func envelopeWithMessage(t *testing.T, message string, unavailable bool) []byte {
+	t.Helper()
+	body, err := json.Marshal(map[string]any{
+		"error": map[string]any{
+			"type":    "rate_limit_error",
+			"code":    "upstream_rate_limit",
+			"message": message,
+			"details": map[string]any{
+				"projection":          "vm2api.safe_error.v1",
+				"message_unavailable": unavailable,
+			},
+		},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return body
+}
+
+func TestMatchTrustedOracle429IgnoresUnknownFields(t *testing.T) {
+	body := strings.Replace(validEnvelope,
+		`"message_unavailable":false`,
+		`"message_unavailable":false,"unknown_secret":"Bearer must-not-leak","nested":{"path":"/home/service/.env"}`,
+		1,
+	)
+	got, ok := MatchTrustedOracle429(18, 1146, true, 429, []byte(body))
+	if !ok {
+		t.Fatal("safe known fields should still match when unknown fields are present")
+	}
+	if got.Message != "Oracle capacity is temporarily unavailable; retry shortly." || strings.Contains(got.Message, "must-not-leak") {
+		t.Fatalf("unknown field leaked: %+v", got)
+	}
+}
+
+func TestMatchTrustedOracle429RejectsOversizedEnvelope(t *testing.T) {
+	body := []byte(validEnvelope + strings.Repeat(" ", maxEnvelopeBytes))
+	if got, ok := MatchTrustedOracle429(18, 1146, true, 429, body); ok {
+		t.Fatalf("oversized envelope matched: %+v", got)
+	}
+}
