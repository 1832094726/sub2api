diff --git a/backend/internal/handler/gateway_safe_error_projection_test.go b/backend/internal/handler/gateway_safe_error_projection_test.go
new file mode 100644
index 0000000..5d6e87f
--- /dev/null
+++ b/backend/internal/handler/gateway_safe_error_projection_test.go
@@ -0,0 +1,147 @@
+package handler
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/require"
+)
+
+const safeProjectedMessage = "Oracle capacity is temporarily unavailable; retry shortly."
+
+func projected429ForHandlerTest(t *testing.T, message string, unavailable bool) *service.UpstreamFailoverError {
+	t.Helper()
+	body, err := json.Marshal(map[string]any{
+		"error": map[string]any{
+			"type":    "rate_limit_error",
+			"code":    "upstream_rate_limit",
+			"message": message,
+			"details": map[string]any{
+				"projection":          "vm2api.safe_error.v1",
+				"message_unavailable": unavailable,
+				"unknown_secret":      "Bearer must-not-leak",
+			},
+		},
+	})
+	require.NoError(t, err)
+	return &service.UpstreamFailoverError{StatusCode: http.StatusTooManyRequests, ResponseBody: body}
+}
+
+func newGatewayErrorTestContext(t *testing.T) (*gin.Context, *httptest.ResponseRecorder) {
+	t.Helper()
+	gin.SetMode(gin.TestMode)
+	w := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(w)
+	c.Request = httptest.NewRequest(http.MethodPost, "/v1/messages", nil)
+	return c, w
+}
+
+func TestSafeErrorProjectionDirectJSON(t *testing.T) {
+	c, w := newGatewayErrorTestContext(t)
+	groupID := int64(18)
+
+	(&GatewayHandler{}).handleFailoverExhaustedWithSource(
+		c,
+		projected429ForHandlerTest(t, safeProjectedMessage, false),
+		service.PlatformAnthropic,
+		&groupID,
+		1146,
+		true,
+		false,
+	)
+
+	require.Equal(t, http.StatusTooManyRequests, w.Code)
+	require.JSONEq(t, `{"type":"error","error":{"type":"rate_limit_error","code":"upstream_rate_limit","message":"Oracle capacity is temporarily unavailable; retry shortly."}}`, w.Body.String())
+	require.NotContains(t, w.Body.String(), "must-not-leak")
+}
+
+func TestSafeErrorProjectionCommittedSSE(t *testing.T) {
+	c, w := newGatewayErrorTestContext(t)
+	groupID := int64(18)
+	_, err := c.Writer.Write([]byte(": keepalive\n\n"))
+	require.NoError(t, err)
+
+	(&GatewayHandler{}).handleFailoverExhaustedWithSource(
+		c,
+		projected429ForHandlerTest(t, safeProjectedMessage, false),
+		service.PlatformAnthropic,
+		&groupID,
+		1146,
+		true,
+		true,
+	)
+
+	body := w.Body.String()
+	require.Contains(t, body, `data: {"type":"error","error":{"type":"rate_limit_error","code":"upstream_rate_limit","message":"Oracle capacity is temporarily unavailable; retry shortly."}}`)
+	require.True(t, strings.HasPrefix(body, ": keepalive\n\n"))
+	require.NotContains(t, body, "must-not-leak")
+}
+
+func TestSafeErrorProjectionScopeMismatchUsesLegacyGeneric(t *testing.T) {
+	tests := []struct {
+		name      string
+		groupID   int64
+		accountID int64
+		trusted   bool
+	}{
+		{"wrong group", 1, 1146, true},
+		{"wrong account", 18, 1147, true},
+		{"untrusted endpoint", 18, 1146, false},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			c, w := newGatewayErrorTestContext(t)
+			groupID := tc.groupID
+			(&GatewayHandler{}).handleFailoverExhaustedWithSource(
+				c,
+				projected429ForHandlerTest(t, safeProjectedMessage, false),
+				service.PlatformAnthropic,
+				&groupID,
+				tc.accountID,
+				tc.trusted,
+				false,
+			)
+
+			require.Equal(t, http.StatusTooManyRequests, w.Code)
+			require.JSONEq(t, `{"type":"error","error":{"type":"rate_limit_error","message":"Upstream rate limit exceeded, please retry later"}}`, w.Body.String())
+			require.NotContains(t, w.Body.String(), safeProjectedMessage)
+		})
+	}
+}
+
+func TestSafeErrorProjectionMessageUnavailableUsesFixedText(t *testing.T) {
+	c, w := newGatewayErrorTestContext(t)
+	groupID := int64(18)
+	(&GatewayHandler{}).handleFailoverExhaustedWithSource(
+		c,
+		projected429ForHandlerTest(t, "password=must-not-leak", true),
+		service.PlatformAnthropic,
+		&groupID,
+		1146,
+		true,
+		false,
+	)
+
+	require.JSONEq(t, `{"type":"error","error":{"type":"rate_limit_error","code":"upstream_rate_limit","message":"Upstream error details unavailable"}}`, w.Body.String())
+	require.NotContains(t, w.Body.String(), "must-not-leak")
+}
+
+func TestSafeErrorProjectionScopeDoesNotLeakAcrossCalls(t *testing.T) {
+	h := &GatewayHandler{}
+	groupID := int64(18)
+
+	trustedContext, trustedWriter := newGatewayErrorTestContext(t)
+	h.handleFailoverExhaustedWithSource(trustedContext, projected429ForHandlerTest(t, safeProjectedMessage, false), service.PlatformAnthropic, &groupID, 1146, true, false)
+	require.Contains(t, trustedWriter.Body.String(), safeProjectedMessage)
+
+	untrustedContext, untrustedWriter := newGatewayErrorTestContext(t)
+	h.handleFailoverExhaustedWithSource(untrustedContext, projected429ForHandlerTest(t, safeProjectedMessage, false), service.PlatformAnthropic, &groupID, 1147, false, false)
+	require.Contains(t, untrustedWriter.Body.String(), "Upstream rate limit exceeded, please retry later")
+	require.NotContains(t, untrustedWriter.Body.String(), safeProjectedMessage)
+}
