new file mode 100644
index 0000000..e655de9
--- /dev/null
+++ b/backend/internal/pkg/safeerrorprojection/safe_error_projection.go
@@ -0,0 +1,122 @@
+package safeerrorprojection
+
+import (
+	"encoding/json"
+	"regexp"
+	"strings"
+	"unicode"
+	"unicode/utf8"
+)
+
+const (
+	trustedGroupID      int64 = 18
+	trustedAccountID    int64 = 1146
+	maxEnvelopeBytes          = 16 << 10
+	maxSafeMessageBytes       = 400
+	wantErrorType             = "rate_limit_error"
+	wantErrorCode             = "upstream_rate_limit"
+	wantProjection            = "vm2api.safe_error.v1"
+	wantPlatform              = "anthropic"
+	wantBaseURL               = "http://oracle-vm2api-verify:18080"
+	unavailableMessage        = "Upstream error details unavailable"
+)
+
+var (
+	jwtLikePattern     = regexp.MustCompile(`(?:^|[^A-Za-z0-9_-])[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}(?:$|[^A-Za-z0-9_-])`)
+	unixPathPattern    = regexp.MustCompile(`(?:^|[[:space:]"'(=])/(?:[A-Za-z0-9._-]+/)+[A-Za-z0-9._-]+`)
+	windowsPathPattern = regexp.MustCompile(`(?i)(?:^|[[:space:]"'(=])[a-z]:[\\/]`)
+	urlQueryPattern    = regexp.MustCompile(`(?i)https?://[^[:space:]]+\?[^[:space:]]*`)
+	credentialPattern  = regexp.MustCompile(`(?i)(?:sk-|gh[pousr]_|AKIA[0-9A-Z]{12,}|x-api-key|api[_ -]?key|access[_ -]?token|refresh[_ -]?token|client[_ -]?secret|(?:password|passwd|secret)["']?\s*[:=]|authorization\s*:|bearer\s+|cookie\s*:|set-cookie\s*:|-----BEGIN [A-Z ]*PRIVATE KEY-----)`)
+)
+
+// Result contains only client-safe fields. Unknown envelope fields are never
+// copied into this value.
+type Result struct {
+	Message            string
+	MessageUnavailable bool
+}
+
+type envelope struct {
+	Error *projectedError `json:"error"`
+}
+
+type projectedError struct {
+	Type    string            `json:"type"`
+	Code    string            `json:"code"`
+	Message string            `json:"message"`
+	Details *projectedDetails `json:"details"`
+}
+
+type projectedDetails struct {
+	Projection         string `json:"projection"`
+	MessageUnavailable *bool  `json:"message_unavailable"`
+}
+
+// IsTrustedSource binds the server-selected account to the exact local Oracle
+// verification sidecar. No request-controlled value is accepted here.
+func IsTrustedSource(accountID int64, platform, baseURL string) bool {
+	return accountID == trustedAccountID && platform == wantPlatform && baseURL == wantBaseURL
+}
+
+// MatchTrustedOracle429 accepts the frozen projection only when both trusted
+// routing dimensions and the server-side endpoint binding are known. Missing
+// context fails closed.
+func MatchTrustedOracle429(groupID, accountID int64, trustedSource bool, statusCode int, body []byte) (Result, bool) {
+	if groupID != trustedGroupID || accountID != trustedAccountID || !trustedSource || statusCode != 429 {
+		return Result{}, false
+	}
+	if len(body) == 0 || len(body) > maxEnvelopeBytes {
+		return Result{}, false
+	}
+
+	var decoded envelope
+	if err := json.Unmarshal(body, &decoded); err != nil || decoded.Error == nil || decoded.Error.Details == nil {
+		return Result{}, false
+	}
+	errBody := decoded.Error
+	details := errBody.Details
+	if errBody.Type != wantErrorType || errBody.Code != wantErrorCode || details.Projection != wantProjection {
+		return Result{}, false
+	}
+	if details.MessageUnavailable == nil {
+		return Result{}, false
+	}
+	if *details.MessageUnavailable {
+		return Result{Message: unavailableMessage, MessageUnavailable: true}, true
+	}
+
+	if !safeMessage(errBody.Message) {
+		return Result{}, false
+	}
+	message := strings.TrimSpace(errBody.Message)
+	if message == "" {
+		return Result{}, false
+	}
+	return Result{Message: message}, true
+}
+
+func safeMessage(message string) bool {
+	if message == "" || len(message) > maxSafeMessageBytes || !utf8.ValidString(message) {
+		return false
+	}
+	for _, r := range message {
+		if unicode.IsControl(r) || unicode.In(r, unicode.Cf, unicode.Co, unicode.Cs) {
+			return false
+		}
+	}
+
+	lower := strings.ToLower(message)
+	for _, fragment := range []string{
+		"stack trace", "traceback", "goroutine ", "panic:",
+		"system prompt", "developer prompt", "prompt stack", "<system>",
+	} {
+		if strings.Contains(lower, fragment) {
+			return false
+		}
+	}
+	return !credentialPattern.MatchString(message) &&
+		!jwtLikePattern.MatchString(message) &&
+		!unixPathPattern.MatchString(message) &&
+		!windowsPathPattern.MatchString(message) &&
+		!urlQueryPattern.MatchString(message)
+}
